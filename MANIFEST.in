prune .venv
prune .uv-cache
prune .tracker-cache
prune .wandb
prune artifacts
prune logs
prune dist
prune build

global-exclude *.py[cod]
global-exclude __pycache__

# Local-only reference assets (do not distribute).
exclude src/tracker/assets/adam_pro/adam_pro_stl.xml
exclude src/tracker/assets/adam_pro/adam_pro.urdf
